# PostgreSQL connection string. Use the pooled Neon URL in deployed environments.
DATABASE_URL=postgresql://stockerp:stockerp@localhost:5432/stockerp

# Absolute path to the confidential source export. Never place it in Git.
ERP_EXPORT_PATH=C:\\path\\to\\cora-erp-masked.json

# Identifies logs and health responses.
APP_ENV=development
