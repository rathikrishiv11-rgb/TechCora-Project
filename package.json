{
  "name": "stockerp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:runtime": "node --experimental-strip-types scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "data:analyze": "node --experimental-strip-types scripts/analyze-export.ts",
    "data:import": "node --experimental-strip-types scripts/import-export.ts",
    "data:reconcile": "node --experimental-strip-types scripts/reconcile.ts",
    "data:verify-db": "node --experimental-strip-types scripts/verify-database.ts",
    "data:rebuild-summaries": "node --experimental-strip-types scripts/rebuild-summaries.ts",
    "benchmark": "node --experimental-strip-types scripts/benchmark.ts",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "drizzle-orm": "0.45.3",
    "next": "16.3.8",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "18.0.5",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
